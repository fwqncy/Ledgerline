{
  "name": "ledgerline",
  "private": true,
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev -w @ledgerline/console",
    "build": "npm run build -w @ledgerline/console",
    "start": "npm run start -w @ledgerline/console",
    "typecheck": "tsc -p apps/console --noEmit"
  }
}
