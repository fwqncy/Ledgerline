# Copy to .env for local development (docker compose sets these itself).
DATABASE_URL=postgresql://ledgerline:ledgerline@localhost:5433/partner_api
PORT=4000

# Signs partner access tokens (HS256). Use 32+ random bytes in production.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
# Peppers the API key hashes. Rotating it invalidates every key.
API_KEY_PEPPER=dev-only-pepper-change-me
# Used by the developer portal's server-side routes to manage keys.
PARTNER_ADMIN_TOKEN=dev-admin-token

# Access token lifetime in seconds.
TOKEN_TTL_SECONDS=900
# Requests per minute, per partner (or per IP before sign-in).
RATE_LIMIT_PER_MINUTE=120
# Simulated settlement: pending payouts are marked paid after this many ms. 0 disables it.
SETTLE_AFTER_MS=15000
