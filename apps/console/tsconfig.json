{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../modules/**/*.ts", "../../modules/**/*.tsx", "../../packages/**/*.ts", "../../packages/**/*.tsx"],
  "exclude": ["node_modules"]
}
